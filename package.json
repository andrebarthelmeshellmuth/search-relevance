{
  "name": "search-relevance",
  "private": true,
  "type": "module",
  "description": "search-relevance.dev static site, built with Eleventy: shared templates in _includes/, per-language content in _data/en.js and _data/de.js.",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "lint:html": "html-validate _site/index.html _site/de/index.html _site/screenshots.html _site/de/screenshots.html _site/resources.html _site/de/resources.html",
    "images": "node tools/build-images.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "html-validate": "^11.6.2"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  }
}
